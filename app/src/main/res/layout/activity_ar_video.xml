<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- ── Primary AR view ───────────────────────────────────────────── -->
    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/arSceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ── Header Info ────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AR VIDEO APP"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan your targets to begin"
                android:textColor="#BBFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Status Pill -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Ready"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Scanning hint animation (bottom) ─────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="120dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/glass_background"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Point camera at a target"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detection is instant"
            android:textColor="#BBFFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- ── Target List (New Screen) ───────────────────────────── -->
    <include layout="@layout/layout_target_list" />

    <!-- ── Button to Show List (Replacing FAB for build stability) ── -->
    <ImageButton
        android:id="@+id/btnShowList"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/glass_background"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="@color/white" />

    <!-- ── Permission Request Screen (Matching second image) ───────── -->
    <include layout="@layout/layout_permission" />

</FrameLayout>
